{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Secra-Solutions/conector",
  "title": "Conector",
  "description": "Self-hosted MCP gateway: connect 1,178 apps once and use them from any AI agent.",
  "version": "0.1.7",
  "websiteUrl": "https://github.com/Secra-Solutions/Conector",
  "repository": {
    "url": "https://github.com/Secra-Solutions/Conector",
    "source": "github"
  },
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/Secra-Solutions/Conector/main/public/brand/icon-192.png",
      "mimeType": "image/png",
      "sizes": ["192x192"]
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "conector",
      "version": "0.1.7",
      "runtimeHint": "npx",
      "transport": { "type": "stdio" },
      "packageArguments": [{ "type": "positional", "value": "stdio" }],
      "environmentVariables": [
        {
          "name": "CONECTOR_URL",
          "description": "MCP endpoint of your Conector server",
          "default": "http://localhost:8790/mcp",
          "isRequired": true,
          "format": "string"
        },
        {
          "name": "CONECTOR_TOKEN",
          "description": "Access token (cnr_…) created in the Conector panel under Connect agents",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        }
      ]
    }
  ]
}
