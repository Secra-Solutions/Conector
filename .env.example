# Copy to .env (or export the variables) to change the defaults. Every variable is optional.

# Address and port the server listens on. Keep 127.0.0.1 and put a reverse proxy in front for remote access.
CONECTOR_HOST=127.0.0.1
CONECTOR_PORT=8790

# The URL people and agents use to reach Conector. It is shown in the "Connect agents" page and used as the
# OAuth redirect URI (<public url>/oauth/callback). Use an https:// URL for providers that require HTTPS (Slack…).
CONECTOR_PUBLIC_URL=http://localhost:8790

# Extra host names allowed in the Host header (comma separated), e.g. a LAN name. The public URL host,
# localhost and 127.0.0.1 are always allowed; any other host is rejected to block DNS rebinding.
CONECTOR_ALLOWED_HOSTS=

# Where users, tokens and encrypted credentials are stored (default: ./data).
CONECTOR_DATA_DIR=

# Set to 1 when running behind a reverse proxy that sets X-Forwarded-For / X-Forwarded-Proto.
CONECTOR_TRUST_PROXY=0

# With an https:// public URL, Conector sends Strict-Transport-Security. Set to 0 when the same host name also serves
# plain-HTTP services on other ports (HSTS applies to every port of the host).
CONECTOR_HSTS=1

# Hours of inactivity before a panel session expires.
CONECTOR_SESSION_HOURS=12
